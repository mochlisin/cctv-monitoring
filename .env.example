# Salin ke .env lalu sesuaikan.
#
# CATATAN: variabel NEXT_PUBLIC_* dibekukan saat `npm run build`, bukan saat
# start. Isi sampai benar sebelum build; mengubahnya setelah build tidak
# berpengaruh sampai di-build ulang.

# connection_limit membatasi pool Prisma. Default (cpu*2)+1 terlalu boros untuk
# MySQL kecil.
DATABASE_URL="mysql://user:password@localhost:3306/cctv_monitoring?connection_limit=5"

# Melindungi sesi login DAN izin menonton stream.
# Buat dengan: openssl rand -base64 48
JWT_SECRET="ganti-dengan-string-acak-panjang"

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# MEDIA SERVER (MediaMTX)
# ============================================
MEDIAMTX_API_URL=http://127.0.0.1:9997
# Berapa lama koneksi ke kamera ditahan setelah penonton terakhir pergi.
MEDIAMTX_CLOSE_AFTER=10s
# Sinkronisasi daftar path saat server start & tiap 60 detik.
MEDIAMTX_AUTO_SYNC=true

# Transport RTSP saat MediaMTX menarik dari kamera: automatic | udp | tcp
#
# Setelan paling berpengaruh terhadap latensi di berkas ini, dan arahnya
# berlawanan dengan dugaan biasa. TCP tidak pernah membuang apa pun: begitu
# uplink kamera lebih sempit dari bitrate-nya, frame menumpuk di kamera dan
# tetap dikirim seluruhnya — hanya terlambat, dan terlambatnya menumpuk tanpa
# batas sampai hitungan MENIT. Gejalanya: "kadang realtime, sering telat
# 2-7 menit". Dengan UDP, kelebihan data dibuang, sehingga latensi berhenti
# tumbuh dan berganti jadi artefak sesekali.
#
#   automatic (bawaan) — UDP dulu, jatuh ke TCP. Aman untuk semua kasus.
#   udp               — paksa UDP. Pilihan terbaik kalau kamera di LAN.
#   tcp               — hanya kalau jaringan memblokir UDP; terima konsekuensi
#                       di atas dan pastikan bitrate kamera di bawah kapasitas.
MEDIAMTX_RTSP_TRANSPORT=automatic

# Origin internal MediaMTX yang di-proxy Next.
MEDIA_HLS_ORIGIN=http://127.0.0.1:8888
MEDIA_WEBRTC_ORIGIN=http://127.0.0.1:8889
# Sumber RTSP lokal untuk pengambilan thumbnail.
MEDIA_RTSP_ORIGIN=rtsp://127.0.0.1:8554

# auto = WebRTC dulu lalu jatuh ke HLS | webrtc = tanpa fallback | hls = paksa HLS
NEXT_PUBLIC_STREAM_TRANSPORT=auto
# Isi kalau penonton berada di jaringan berbeda dan butuh STUN.
# NEXT_PUBLIC_WEBRTC_STUN=stun:stun.l.google.com:19302

# ============================================
# THUMBNAIL
# ============================================
# Umur cache sebelum frame disegarkan di latar belakang.
THUMBNAIL_TTL_SECONDS=120

# ============================================
# HSE MONITORING (deteksi helm & rompi)
# ============================================
# Dibaca oleh worker (npm run hse) DAN oleh aplikasi Next. Keduanya harus
# melihat nilai yang sama — kalau HSE_MAX_CAMERAS berbeda, admin akan bisa
# menyalakan kamera yang diam-diam tidak pernah dianalisis worker.

# API lokal worker. Hanya 127.0.0.1; Next satu-satunya yang memanggilnya.
HSE_WORKER_URL=http://127.0.0.1:9998
HSE_PORT=9998

# Bobot model dan daftar kelasnya. Pasang dengan: npm run hse:model
HSE_MODEL_PATH=./models/ppe.onnx
HSE_CLASSES_PATH=./models/ppe.classes.json
# HSE_MODEL_URL=https://...

# --- Beban CPU. Empat baris berikut yang menentukan apakah server kuat. ---
# Batas keras jumlah kamera HSE. Melewatinya tidak memunculkan error apa pun;
# yang terjadi adalah deteksi diam-diam tertinggal beberapa menit.
HSE_MAX_CAMERAS=3
# Detik antar analisis per kamera. Orang tidak melepas helm dalam 60 milidetik —
# frame rate tinggi tidak menambah keandalan, hanya menambah beban.
HSE_INTERVAL_SECONDS=5
# Sisi masukan model. HARUS sama dengan imgsz saat model diekspor ke ONNX —
# graf hasil ekspor YOLO berukuran tetap, jadi mengubah angka ini tanpa
# mengekspor ulang model membuat worker gagal start.
#
# JANGAN naikkan ke 640 di server 2 core / 2 GB. Inferensi ~75% lebih lambat,
# rem otomatis di bawah melebarkan intervalnya sendiri, dan yang turun adalah
# CAKUPAN WAKTU — lebih banyak detik yang tidak terlihat siapa pun. Untuk
# keselamatan, itu pertukaran yang salah arah.
HSE_INPUT_SIZE=480
# 1 thread disengaja: sisakan CPU untuk Next, MySQL, dan MediaMTX.
HSE_THREADS=1

# Rem otomatis: kalau rata-rata inferensi melewati ambang ini, interval
# dinaikkan sendiri sampai HSE_MAX_INTERVAL_SECONDS.
HSE_SLOW_INFERENCE_MS=1500
HSE_MAX_INTERVAL_SECONDS=30

# Analisis dipercepat sementara saat ada yang membuka halaman kameranya,
# supaya overlay kotak deteksi terasa hidup. Padam sendiri setelah TTL.
HSE_BOOST_INTERVAL_SECONDS=1
HSE_BOOST_TTL_SECONDS=30

# Hanya dekode keyframe. Penghematan CPU terbesar di worker; laju maksimumnya
# jadi terikat interval I-frame kamera (README menganjurkan = fps).
HSE_DECODE_KEYFRAMES_ONLY=true

# --- Ambang deteksi ---
HSE_CONF_THRESHOLD=0.35
HSE_IOU_THRESHOLD=0.45
# Orang dengan tinggi di bawah pecahan frame ini diabaikan: kotak helmnya hanya
# beberapa piksel, dan model menebak. Tebakan tidak boleh masuk statistik.
HSE_MIN_PERSON_HEIGHT=0.12

# --- Event & penyimpanan ---
# Detik bersih sebelum satu event pelanggaran dianggap selesai.
HSE_EVENT_GAP_SECONDS=20
HSE_BUCKET_MINUTES=15
# Frame bukti. Di luar public/ dengan sengaja — dilayani route handler yang
# memeriksa sesi, karena isinya orang yang dapat dikenali di lokasi kerja.
HSE_SNAPSHOT_DIR=./.hse/snapshots
HSE_SNAPSHOT_MIN_INTERVAL_SECONDS=60
HSE_RETENTION_DAYS=30

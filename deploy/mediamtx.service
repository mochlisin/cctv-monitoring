[Unit]
Description=MediaMTX (media server CCTV)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cctv
Group=cctv
WorkingDirectory=/opt/cctv-monitoring
ExecStart=/opt/cctv-monitoring/bin/mediamtx /opt/cctv-monitoring/mediamtx.yml
Restart=always
RestartSec=5

# MediaMTX hanya perlu membaca konfigurasinya sendiri.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

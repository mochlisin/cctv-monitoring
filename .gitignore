# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...tapi contoh tanpa rahasia tetap ikut, supaya hasil clone bisa langsung jalan
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# sertifikat self-signed yang dibuat next dev
auto.crt
auto.key

# binary MediaMTX (dipasang lewat: npm run media:install)
/bin

# cache thumbnail kamera
/.thumbnails

# bobot model HSE — puluhan megabyte, dipasang lewat: npm run hse:model
/models/*.onnx

# frame bukti pelanggaran HSE. Berisi orang yang dapat dikenali di lokasi kerja
# mereka; jangan pernah ikut ke repositori.
/.hse
